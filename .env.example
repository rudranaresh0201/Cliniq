# Required
GROQ_API_KEY=

# RAG / retrieval settings
SIMILARITY_THRESHOLD=0.85
MAX_SEARCH_RESULTS=5
MAX_RETRY_LOOPS=3

# Supabase (patient database)
SUPABASE_URL=
SUPABASE_KEY=

# LLM fallback chain (optional — Groq is tried first)
GEMINI_API_KEY=
OPENROUTER_API_KEY=

# Admin key for protected endpoints (e.g. /api/evaluation/run)
ADMIN_KEY=your_secret_admin_key_here
